<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#1A1A1A"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Profile Image with Match Percentage -->
        <FrameLayout
            android:id="@+id/profile_container"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/img_profile"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/profilepic"
                app:civ_border_width="2dp"
                app:civ_border_color="#C8FF00" />

            <TextView
                android:id="@+id/txt_match_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="94%"
                android:textColor="#000000"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="#C8FF00"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_gravity="bottom|center_horizontal" />

        </FrameLayout>

        <!-- Name and Location -->
        <TextView
            android:id="@+id/txt_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Elena Vance"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintTop_toTopOf="@id/profile_container"
            app:layout_constraintStart_toEndOf="@id/profile_container"
            app:layout_constraintEnd_toStartOf="@id/btn_menu" />

        <TextView
            android:id="@+id/txt_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="📍 San Francisco, CA"
            android:textColor="#888888"
            android:textSize="11sp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@id/txt_name"
            app:layout_constraintStart_toEndOf="@id/profile_container"
            app:layout_constraintEnd_toStartOf="@id/btn_menu" />

        <!-- Menu Button -->
        <ImageView
            android:id="@+id/btn_menu"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_more"
            app:tint="#888888"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Teaches Section -->
        <LinearLayout
            android:id="@+id/teaches_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#2A2A2A"
            android:padding="10dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/profile_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ TEACHES"
                android:textColor="#C8FF00"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/teaches_tags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_teaches_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UI Design"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="#C8FF00"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/txt_teaches_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Motion Graphics"
                    android:textColor="#C8FF00"
                    android:textSize="11sp"
                    android:background="@android:color/transparent"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Wants Section -->
        <LinearLayout
            android:id="@+id/wants_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#2A2A2A"
            android:padding="10dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/teaches_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 WANTS"
                android:textColor="#888888"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/wants_tags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_wants_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Backend Dev"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:background="@android:color/transparent"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/txt_wants_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rust"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:background="@android:color/transparent"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Action Buttons: Connect, Message, and Bookmark -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/wants_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/btn_connect"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Connect"
                android:textColor="#C8FF00"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="#2A2A2A"
                app:cornerRadius="22dp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_message"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Message"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="#C8FF00"
                app:cornerRadius="22dp"
                android:layout_marginEnd="6dp" />

            <ImageView
                android:id="@+id/btn_bookmark"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@android:drawable/btn_star_big_off"
                android:padding="10dp"
                android:background="@drawable/rounded_bg"
                app:tint="#C8FF00" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
